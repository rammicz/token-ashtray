+/// Make the next `ShouldAppsUseDarkMode` answer reflect the current appearance.
+pub fn refresh_immersive_color_policy() {
+    type RefreshImmersiveColorPolicyState = unsafe extern "system" fn();
+    static REFRESH_IMMERSIVE_COLOR_POLICY_STATE: Lazy<Option<RefreshImmersiveColorPolicyState>> =
+        Lazy::new(|| unsafe {
+            const UXTHEME_REFRESHIMMERSIVECOLORPOLICYSTATE_ORDINAL: PCSTR = 104 as PCSTR;
+
+            if !*DARK_MODE_SUPPORTED {
+                return None;
+            }
+
+            let module = LoadLibraryA("uxtheme.dll\0".as_ptr().cast());
+
+            if module == 0 {
+                return None;
+            }
+
+            let handle = GetProcAddress(module, UXTHEME_REFRESHIMMERSIVECOLORPOLICYSTATE_ORDINAL);
+
+            handle.map(|handle| std::mem::transmute(handle))
+        });
+
+    if let Some(refresh) = *REFRESH_IMMERSIVE_COLOR_POLICY_STATE {
+        unsafe { (refresh)() }
+    }
+}
